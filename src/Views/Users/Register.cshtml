@model RegisterViewModel

<h1>Register</h1>

<form asp-action="Register" asp-controller="Users" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <label asp-for="Username">Username:</label>
    <input asp-for="Username" autocomplete="username" />
    <span asp-validation-for="Username" class="text-danger"></span>

    <label asp-for="Email">Email:</label>
    <input asp-for="Email" autocomplete="email" />
    <span asp-validation-for="Email" class="text-danger"></span>

    <label asp-for="Password">Password:</label>
    <input asp-for="Password" autocomplete="new-password" />
    <span asp-validation-for="Password" class="text-danger"></span>

    <label asp-for="ConfirmPassword">Confirm password:</label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

    <button type="submit">Create account</button>
</form>

<p>Already registered? <a asp-action="Login">Sign in</a></p>
